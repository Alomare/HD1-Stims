{
  "obsidian": 1,
  "id": "alomare.stims",
  "version": "1.0.0",
  "name": {
    "en": "Stims"
  },
  "description": {
    "en": "Adds the stims from Helldivers 2, adapted to Helldivers 1 mechanics. Can stim while prone or downed."
  },
  "authors": [
    "Alomare"
  ],
  "image": "icon.jpg",
  "scope": "session",
  "every_player": true,
  "entry": "main.lua",
  "source": "https://github.com/Alomare/HD1-Stims",
  "modules": [
    "src/stim.lua",
    "src/stock.lua",
    "src/sync.lua",
    "src/anim.lua",
    "src/pose.lua",
    "src/hud.lua",
    "src/hud_layout.lua",
    "src/sound.lua",
    "src/sounds.lua"
  ],
  "requires": [
    "obsidian.api"
  ],
  "resources": [
    {
      "type": "texture",
      "name": "stims/hud/stims_syringe1",
      "bundle": "9cf71054ea26dddf",
      "data": "res/hud_syringe1.texture"
    },
    {
      "type": "texture",
      "name": "stims/hud/stims_syringe2",
      "bundle": "9cf71054ea26dddf",
      "data": "res/hud_syringe2.texture"
    },
    {
      "type": "texture",
      "name": "stims/hud/stims_syringe3",
      "bundle": "9cf71054ea26dddf",
      "data": "res/hud_syringe3.texture"
    },
    {
      "type": "texture",
      "name": "stims/hud/stims_syringe4",
      "bundle": "9cf71054ea26dddf",
      "data": "res/hud_syringe4.texture"
    },
    {
      "type": "texture",
      "name": "stims/hud/stims_edge",
      "bundle": "9cf71054ea26dddf",
      "data": "res/hud_edge.texture"
    },
    {
      "type": "material",
      "name": "stims/hud",
      "bundle": "9cf71054ea26dddf",
      "data": "res/hud.material"
    }
  ],
  "options": [
    {
      "id": "max_stims",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": {
        "en": "Maximum stim count"
      },
      "description": {
        "en": "Stims each Helldiver can carry, and starts each drop and respawn with."
      }
    },
    {
      "id": "preserve_passive_healing",
      "type": "toggle",
      "default": false,
      "label": {
        "en": "Preserve passive healing"
      },
      "description": {
        "en": "Keeps the slow health regeneration of the game. Off by default, so health comes back only through stims and other healing. The extra regeneration of the Autoinjector perk stays either way."
      }
    },
    {
      "id": "status_immunity",
      "type": "toggle",
      "default": true,
      "label": {
        "en": "Status effect immunity"
      },
      "description": {
        "en": "While a stim lasts, the Helldiver takes no status effects such as fire, poison, stun, slow or confusion, and the stim clears the ones already on. Slows from water, snow and carried objectives stay."
      }
    },
    {
      "id": "allow_downed_stim",
      "type": "toggle",
      "default": true,
      "label": {
        "en": "Allow downed stim"
      },
      "description": {
        "en": "A downed Helldiver can use a stim to get back up and heal."
      }
    },
    {
      "id": "volume",
      "type": "number",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "scope": "client",
      "label": {
        "en": "Stim sound volume"
      },
      "description": {
        "en": "How loud the stim sound plays. Other players' stims nearby play quieter."
      }
    }
  ],
  "keybinds": [
    {
      "id": "stim",
      "default": "v",
      "label": {
        "en": "Use a stim"
      }
    }
  ],
  "loader_api": 1
}
