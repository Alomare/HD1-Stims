{
  "obsidian": 1,
  "id": "alomare.stims",
  "version": "0.1.0",
  "name": { "en": "Stims" },
  "description": { "en": "Stim injectors: up to four per Helldiver, three on each drop, two more from each ammo box. A stim gives four seconds of fast healing and endless stamina, shown on the loadout card and seen by the whole squad." },
  "authors": ["Alomare"],
  "image": "icon.jpg",
  "scope": "session",
  "every_player": true,
  "entry": "main.lua",
  "source": "https://github.com/Alomare/HD1-Stims",
  "modules": ["src/stim.lua", "src/stock.lua", "src/sync.lua", "src/anim.lua", "src/pose.lua", "src/hud.lua", "src/hud_layout.lua", "src/sound.lua", "src/sounds.lua"],
  "requires": ["obsidian.api"],
  "resources": [
    { "type": "texture", "name": "stims/hud/stims_syringe", "bundle": "9cf71054ea26dddf", "data": "res/hud_syringe.texture" },
    { "type": "material", "name": "stims/hud", "bundle": "9cf71054ea26dddf", "data": "res/hud.material" }
  ],
  "options": [
    { "id": "volume", "type": "number", "default": 0.7, "min": 0, "max": 1, "step": 0.05, "scope": "client",
      "label": { "en": "Stim sound volume" },
      "description": { "en": "How loud the stim sound plays. Other players' stims nearby play quieter." } }
  ],
  "keybinds": [
    { "id": "stim", "default": "v", "label": { "en": "Use a stim" } }
  ],
  "loader_api": 1
}
